# First local startup: the agent runs the documented bootstrap; do not copy this
# placeholder over its generated private .env. This example is for explicit hosting.
DATABASE_PROVIDER=mongoose
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority"
PAYLOAD_SECRET="REPLACE_WITH_RANDOM_SECRET"
PREVIEW_SECRET="REPLACE_WITH_RANDOM_SECRET"
# Optional: authenticate an explicitly configured external recovery/scheduling runner.
# CRON_SECRET="REPLACE_WITH_RANDOM_SECRET"
# Optional on a persistent Node host: retry committed publication work every 10 seconds.
# SMARTSITE_BACKGROUND_RECOVERY=true
# Future publishing remains off until enabled in each native collection/global config.
SMARTSITE_SITE_ID="REPLACE_WITH_DESTINATION_UUID"
SMARTSITE_ENVIRONMENT="production"
NEXT_PUBLIC_URL="https://YOUR_DOMAIN"
# Configure an explicit storage plugin in src/payload.config.ts before supplying its credentials.
# Configure a real email adapter before enabling outbound mail.

# --- Durable media storage (required on serverless hosts such as EdgeOne Makers) ---
# SMARTSITE_MEDIA_STORAGE=s3
# S3_BUCKET="bucket-1250000000"
# S3_REGION="ap-singapore"
# S3_ENDPOINT="https://cos.ap-singapore.myqcloud.com"
# S3_ACCESS_KEY_ID="REPLACE"
# S3_SECRET_ACCESS_KEY="REPLACE"
# S3_PUBLIC_URL="https://bucket-1250000000.cos.ap-singapore.myqcloud.com"
# S3_PREFIX="media"
# S3_CLIENT_UPLOADS="true"
# S3_FORCE_PATH_STYLE="false"
# Optional: report Node/OpenSSL versions in /api/smartsite/health (host verification only).
# SMARTSITE_RUNTIME_PROBE=true
